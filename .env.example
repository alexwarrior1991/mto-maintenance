# Todo lo que la aplicacion lee del entorno esta en este fichero. Lo que va comentado tiene un valor
# por defecto en application*.yaml que sirve tal cual. Las variables del perfil 'test'
# (TEST_DATABASE_*) no estan aqui a proposito: las usa la suite, no el contenedor.

# Spring application
SPRING_PROFILES_ACTIVE=prod
# SPRING_PROFILES_DEFAULT=dev
SERVER_PORT=8080
# Puerto publicado en el host. 8083 para no chocar con mto-stock (8080) ni mto-configuration (8081).
APP_PORT=8083
APP_IMAGE_TAG=latest
APP_VERSION=0.0.1-SNAPSHOT

# Application database connection.
# The database itself lives in mto-platform, published on the host. From inside this container it
# is reached through host.docker.internal; from the IDE, through localhost.
DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/mto_maintenance
DATABASE_USERNAME=mto_maintenance_user
DATABASE_PASSWORD=mto_maintenance_password

# Keycloak / OAuth2 resource server. La API valida los JWT que emite Keycloak.
KEYCLOAK_ISSUER_URI=http://auth.mto.local:8082/realms/mto
KEYCLOAK_CLIENT_ID=mto-maintenance-api
KEYCLOAK_AUDIENCE=mto-maintenance-api
KEYCLOAK_AUDIENCE_VALIDATION_ENABLED=true

# Cuenta de servicio con la que este servicio llama a mto-stock (client_credentials). El cliente lo
# crea keycloak/mto-maintenance-partial-import.json; el secreto lo genera Keycloak y se copia de
# Clients -> mto-maintenance-svc -> Credentials. Sin el, cada reserva de material queda en FAILED.
KEYCLOAK_TOKEN_URI=http://auth.mto.local:8082/realms/mto/protocol/openid-connect/token
KEYCLOAK_SERVICE_CLIENT_ID=mto-maintenance-svc
KEYCLOAK_SERVICE_CLIENT_SECRET=

# mto-stock: reservas, consumos y salidas de material. Con APP_STOCK_ENABLED=false la aplicacion
# arranca sin stock y las lineas de material se quedan en NOT_REQUESTED.
APP_STOCK_ENABLED=true
MTO_STOCK_URL=http://host.docker.internal:8080
# Cortacircuitos y timeouts del cliente de stock.
# APP_STOCK_CONNECT_TIMEOUT=2s
# APP_STOCK_READ_TIMEOUT=10s
# APP_STOCK_CB_SLIDING_WINDOW_SIZE=10
# APP_STOCK_CB_MINIMUM_NUMBER_OF_CALLS=5
# APP_STOCK_CB_FAILURE_RATE_THRESHOLD=50
# APP_STOCK_CB_WAIT_DURATION_IN_OPEN_STATE=30s
# APP_STOCK_CB_TIMEOUT=10s

# Publicar /swagger-ui y /v3/api-docs sin token. Cerrado en produccion.
APP_SECURITY_EXPOSE_API_DOCS=false
APP_CORS_ALLOWED_ORIGIN=http://localhost:4200
# APP_CORS_MAX_AGE=3600

# RabbitMQ / master data events from mto-configuration: THE SAME broker mto-configuration publishes
# to, the one in mto-platform. Profiles, disconnectors and section insulators become assets here.
SPRING_RABBITMQ_HOST=host.docker.internal
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=mto
SPRING_RABBITMQ_PASSWORD=mto
SPRING_RABBITMQ_VIRTUAL_HOST=/
APP_RABBITMQ_ENABLED=true
APP_RABBITMQ_MASTER_DATA_LISTENER_ENABLED=true
# APP_RABBITMQ_MASTER_DATA_EXCHANGE=mto.master-data.exchange
# APP_RABBITMQ_MASTER_DATA_QUEUE=mto.maintenance.master-data.queue
# APP_RABBITMQ_MASTER_DATA_ROUTING_KEY=mto.master-data.#
# APP_RABBITMQ_MASTER_DATA_DEAD_LETTER_EXCHANGE=mto.maintenance.master-data.queue.dlx
# APP_RABBITMQ_MASTER_DATA_DEAD_LETTER_QUEUE=mto.maintenance.master-data.queue.dlq
# APP_RABBITMQ_MASTER_DATA_DEAD_LETTER_ROUTING_KEY=mto.maintenance.master-data.queue.dlq
# SPRING_RABBITMQ_LISTENER_CONCURRENCY=1
# SPRING_RABBITMQ_LISTENER_MAX_CONCURRENCY=5
# SPRING_RABBITMQ_LISTENER_PREFETCH=10
# SPRING_RABBITMQ_LISTENER_MAX_RETRIES=3

# Firma de los mensajes. EL MISMO VALOR que app.messaging.signature.secret en mto-configuration.
MESSAGING_SIGNATURE_SECRET=
# DISABLED | OPTIONAL | REQUIRED
MESSAGING_SIGNATURE_MODE=OPTIONAL

# Flyway migrations
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration

# Actuator and observability
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
MANAGEMENT_HEALTH_RABBIT_ENABLED=false
SPRINGDOC_SHOW_ACTUATOR=false

# Logging and JVM
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=INFO
LOGGING_LEVEL_SQL=WARN
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseContainerSupport
# JPA_SHOW_SQL=false
# JPA_FORMAT_SQL=true
# SHUTDOWN_TIMEOUT=30s

# --- Trazado distribuido -----------------------------------------------------------------------
MTO_TRACING_ENABLED=true
MTO_TRACING_SAMPLING_PROBABILITY=0.1
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel.mto.local:4318/v1/traces
SPRING_RABBITMQ_LISTENER_OBSERVATION_ENABLED=true
